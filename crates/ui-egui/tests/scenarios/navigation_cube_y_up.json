[
  {"call":"ui.prefs","params":{"navigator_style":"cube"}},
  {
    "note": "Cube face names follow the up-axis frame; with Y up, Top looks from +Y and Front from +Z."
  },
  {
    "call": "ui.prefs",
    "params": {
      "up_axis": "y"
    }
  },
  {
    "call": "ui.view",
    "params": {
      "view": "home"
    }
  },
  {
    "click": {
      "handle": "navigation_cube:top"
    }
  },
  {
    "expect": {
      "camera": {
        "yaw_deg": 0,
        "pitch_deg": 90,
        "back": [
          0,
          1,
          0
        ]
      }
    }
  },
  {
    "click": {
      "handle": "navigation_cube:control:down"
    }
  },
  {
    "expect": {
      "camera": {
        "yaw_deg": 0,
        "pitch_deg": 0,
        "back": [
          0,
          0,
          1
        ]
      }
    }
  }
]
