[
  {"call":"ui.prefs","params":{"navigator_style":"cube"}},
  {
    "note": "Cube facets own one highlight at a time and choose principal views."
  },
  {
    "call": "ui.view",
    "params": {
      "view": "home"
    }
  },
  {
    "move": {
      "handle": "navigation_cube:top"
    }
  },
  {
    "expect": {
      "count": {
        "name": "axis_view_highlights",
        "value": 1
      }
    }
  },
  {
    "click": {
      "handle": "navigation_cube:top"
    }
  },
  {
    "expect": {
      "camera": {
        "yaw_deg": 0,
        "pitch_deg": 90
      }
    }
  },
  {
    "click": {
      "handle": "navigation_cube:control:down"
    }
  },
  {
    "expect": {
      "camera": {
        "yaw_deg": 0,
        "pitch_deg": 0
      }
    }
  },
  {
    "move": [
      800,
      500
    ]
  },
  {
    "expect": {
      "count": {
        "name": "axis_view_highlights",
        "value": 0
      }
    }
  }
]
