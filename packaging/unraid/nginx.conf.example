# Include in the HTTPS server block for your chosen hostname.
# Replace SOLVECRAFT_CONTAINER_IP with the container's fixed LAN IP,
# or use UNRAID_LAN_IP:8781 when using Docker bridge port mapping.
location / {
    proxy_pass http://SOLVECRAFT_CONTAINER_IP:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_read_timeout 360s;
    proxy_send_timeout 360s;
    client_max_body_size 16m;
}
