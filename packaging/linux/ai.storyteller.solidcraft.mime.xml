<?xml version="1.0" encoding="UTF-8"?>
<!-- shared-mime-info definitions for types the system database may not have.
     Installed to /usr/share/mime/packages/ (update-mime-database runs on install). -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-solidcraft">
    <comment>SolidCraft design</comment>
    <icon name="ai.storyteller.solidcraft"/>
    <sub-class-of type="application/json"/>
    <glob pattern="*.solidcraft"/>
    <!-- Compatibility shim (docs/compatibility.md): designs saved before the rename. -->
    <glob pattern="*.solvecraft"/>
    <alias type="application/x-solvecraft"/>
  </mime-type>
</mime-info>
