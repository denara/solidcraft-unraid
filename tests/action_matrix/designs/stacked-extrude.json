  {"command": "sketch.finish", "params": {}},
  {"command": "solid.extrude", "params": {"distance": "step_h", "operation": "join"}},
  {"command": "sketch.create", "params": {"plane": {"face": [30, 20, 22]}, "name": "Boss"}},
  {"command": "sketch.circle.center", "params": {"center": [30, 20], "radius": 7}},
  {"command": "sketch.finish", "params": {}},
